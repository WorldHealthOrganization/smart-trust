  "narrative": [
    {
      "text": "Percentage of the reviewed economic evaluations that met each Drummond checklist criterion, for all articles, for DiaskinTest-related articles and for TST or IGRA articles. Rows are the checklist questions, grouped under ten main criteria.",
      "lang": "en",
      "state": "draft",
