  "narrative": [
    {
      "text": "Cost per sample reported by Alleweldt et al. (2021) for whole-genome sequencing (WGS) and conventional methods, for eight laboratory settings covering avian influenza, influenza A+B and food-borne pathogens (2021 USD).",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
