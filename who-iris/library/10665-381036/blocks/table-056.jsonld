  "narrative": [
    {
      "text": "Characteristics of the four qualitative studies included in Systematic Review A (TBST) and Systematic Review B (TST and IGRA): publication type, tests, country, facility type and setting, participants, programmatic features, comparators, data collection, study duration, method of analysis, conceptual framework and conflicts of interest.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
