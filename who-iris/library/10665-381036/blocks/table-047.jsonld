  "narrative": [
    {
      "text": "Drummond checklist assessment of the quality of cost and cost-effectiveness analyses of novel skin tests for diagnosing TB infection. Rows are the checklist questions, grouped under ten main criteria; columns give each study's answer and comments, in two blocks of studies.",
      "lang": "en",
      "state": "draft",
