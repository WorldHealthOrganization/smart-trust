  "narrative": [
    {
      "text": "Definitions of the composite reference standard (CRS) used in each included study. Each row names a study and describes the population and the criteria it used to classify participants as having TB under the CRS.",
      "lang": "en",
      "state": "draft",
      "drafted_by": {
