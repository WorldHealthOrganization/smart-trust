{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IG Publication Output",
  "description": "Output schema for FHIR IG publication.",
  "type": "object",
  "required": [
    "version",
    "publishedUrl"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "publishedUrl": {
      "type": "string"
    },
    "releaseTag": {
      "type": "string"
    },
    "releaseBranch": {
      "type": "string"
    },
    "publicationRequestPath": {
      "type": "string"
    },
    "buildStatus": {
      "type": "string",
      "enum": [
        "success",
        "failed"
      ]
    }
  }
}
