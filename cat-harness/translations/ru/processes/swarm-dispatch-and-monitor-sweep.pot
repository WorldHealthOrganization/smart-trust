msgid "Worker idle on compute?"
msgstr ""

#: sdlc/processes/swarm-dispatch-and-monitor-sweep.bpmn:146
#. Diagram label
msgid "Yes"
msgstr ""

#: sdlc/processes/swarm-dispatch-and-monitor-sweep.bpmn:76
#. Diagram element documentation
msgid "Yes when a worker is waiting on single-core or long-running background compute (build, solver, or CI) with no substantive foreground work and non-heavy idle-backlog items exist. No otherwise."
msgstr ""

#: sdlc/processes/swarm-dispatch-and-monitor-sweep.bpmn:54
#. Diagram element documentation
msgid "Yes when any worker subprocess breaches the memory+compressed/swap or root-disk floor, a worker is silent for over 3 minutes or repeats step counters across two sweeps, workers collide on a path, or completed slices diverge structurally. No when healthy."
msgstr ""

#: sdlc/processes/swarm-dispatch-and-monitor-sweep.bpmn:114
#. Diagram element documentation
msgid "Yes when the owner asks for status on-demand, when a user-enabled periodic report timer fires, or when a milestone/exit gate transitions. Quiet when running in background on-demand mode between user requests (handover state in beans is already synced)."
msgstr ""
