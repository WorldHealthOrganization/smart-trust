        <dc:Bounds x="765" y="350" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Sweep_End" bpmnElement="Sweep_End">
        <dc:Bounds x="875" y="357" width="36" height="36"/>
