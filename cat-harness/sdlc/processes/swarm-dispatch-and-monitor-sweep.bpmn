        <di:waypoint x="745" y="145"/>
        <di:waypoint x="795" y="145"/>
        <bpmndi:BPMNLabel><dc:Bounds x="752" y="122" width="32" height="18"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
