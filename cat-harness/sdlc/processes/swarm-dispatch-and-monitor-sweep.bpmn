      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_HandoverRunbook" bpmnElement="DOA_HandoverRunbook">
        <di:waypoint x="210" y="435"/>
        <di:waypoint x="210" y="495"/>
        <di:waypoint x="208" y="495"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_DOA_HandoverBeans" bpmnElement="DOA_HandoverBeans">
        <di:waypoint x="275" y="435"/>
        <di:waypoint x="275" y="495"/>
        <di:waypoint x="335" y="495"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
