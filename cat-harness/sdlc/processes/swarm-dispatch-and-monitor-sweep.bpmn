        <bpmndi:BPMNLabel><dc:Bounds x="726" y="206" width="28" height="18"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SFlow_9" bpmnElement="SFlow_9">
        <di:waypoint x="915" y="145"/>
        <di:waypoint x="960" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_SFlow_10" bpmnElement="SFlow_10">
        <di:waypoint x="1010" y="145"/>
