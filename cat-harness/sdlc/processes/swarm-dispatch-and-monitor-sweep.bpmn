        <dc:Bounds x="695" y="120" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="670" y="54" width="102" height="52"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_AssignIdleComputeBacklog" bpmnElement="Task_AssignIdleComputeBacklog">
        <dc:Bounds x="795" y="85" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Mon_GwJoinIdle" bpmnElement="Mon_GwJoinIdle" isMarkerVisible="true">
        <dc:Bounds x="960" y="120" width="50" height="50"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Shape_Task_RefreshSwarmHandover" bpmnElement="Task_RefreshSwarmHandover">
        <dc:Bounds x="185" y="315" width="120" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Mon_GwReportDue" bpmnElement="Mon_GwReportDue" isMarkerVisible="true">
        <dc:Bounds x="485" y="350" width="50" height="50"/>
