    "prov": "http://www.w3.org/ns/prov#"
  },
  "$schema": "folio-ig-artifact-index-jsonld/v1",
  "@id": "index.jsonld",
  "@type": "fhir:ImplementationGuide",
  "dcterms:identifier": "smart.who.int.trust",
  "schema:version": "1.7.5",
  "schema:sameAs": {
    "@id": "http://smart.who.int/trust"
  },
  "dcterms:title": "WHO SMART Trust",
  "schema:numberOfItems": 761,
  "schema:hasPart": [
    {
      "@id": "ActorDefinition-BusinessOwnerRepresentative",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/BusinessOwnerRepresentative",
      "dcterms:title": "Business Owner Representative",
      "dcterms:description": "The Business Owner Representative of a GDHCN Participant, named in the Letter of Application (Framework IX). Sends the Statement of Interest and the Letter of Application, and may meet WHO in person to convey the Letter.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/BusinessOwnerRepresentative"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-BusinessOwnerRepresentative.json"
      }
    },
    {
      "@id": "ActorDefinition-GDHCNSecretariat",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/GDHCNSecretariat",
      "dcterms:title": "GDHCN Secretariat",
      "dcterms:description": "Authorized WHO staff working in the GDHCN Secretariat, which administers the GDHCN and oversees the Onboarding Process (Framework V, VI).",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/GDHCNSecretariat"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-GDHCNSecretariat.json"
      }
    },
    {
      "@id": "ActorDefinition-GitHubBot",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/GitHubBot",
      "dcterms:title": "GitHub Bot",
      "dcterms:description": "The GitHub bot user of the Trust Network Gateway (one per environment), which is invited to a Participant's private repository, pulls its public key material and opens the onboarding pull request (onboarding steps [11]-[13], [34]-[38]).",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/GitHubBot"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-GitHubBot.json"
      }
    },
    {
      "@id": "ActorDefinition-Holder",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/Holder",
      "dcterms:title": "Holder",
      "dcterms:description": "A Holder is an individual that has Verifiable Digtial Health Certificate in their possesion, received from an Issuer.  The Holder may choose to share the Verifiable Digital Health Certificate with a Receiver.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/Holder"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-Holder.json"
      }
    },
    {
      "@id": "ActorDefinition-Issuer",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/Issuer",
      "dcterms:title": "Issuer",
      "dcterms:description": "An Issuer a system authorized by a Trust Network Participant to generate Verifiable Digital Health Certificates which are provided to a Holder.   An Issuer is responsible for generating the content that is digitally signed within the Verifiable Digital Health Certificate.   In order to sign this content, an Issuer should either itself be a Document Signer or utilize a Document Signer service, as authorized by the jurisdicitonal policy.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/Issuer"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-Issuer.json"
      }
    },
    {
      "@id": "ActorDefinition-KeyMasterRepresentative",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/KeyMasterRepresentative",
      "dcterms:title": "Key Master Representative",
      "dcterms:description": "The individual responsible for a GDHCN Participant's Public Key Infrastructure, including generating key pairs and managing the connections to the Trust Network Gateway (Letter of Application; Framework IX). Holds the GPG key named in the Letter.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/KeyMasterRepresentative"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-KeyMasterRepresentative.json"
      }
    },
    {
      "@id": "ActorDefinition-LegalRepresentative",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/LegalRepresentative",
      "dcterms:title": "Legal Representative",
      "dcterms:description": "The Legal Representative of a GDHCN Participant, named in the Letter of Application (Framework IX). May meet WHO in person to convey the Letter, and receives notice of amendments (Framework XI.2).",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/LegalRepresentative"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-LegalRepresentative.json"
      }
    },
    {
      "@id": "ActorDefinition-OfficialDelegate",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/OfficialDelegate",
      "dcterms:title": "Official Delegate",
      "dcterms:description": "An official delegate of a GDHCN Participant at the World Health Assembly or another meeting of WHO's governing bodies, who may convey the Letter of Application in a face-to-face meeting (Framework IX).",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/OfficialDelegate"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-OfficialDelegate.json"
      }
    },
    {
      "@id": "ActorDefinition-OnboardingTeam",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/OnboardingTeam",
      "dcterms:title": "Onboarding Team",
      "dcterms:description": "The onboarding team of the Trust Network Gateway's service provider, which checks a Participant's test results and confirms production readiness (onboarding steps [64]-[77]).",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/OnboardingTeam"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-OnboardingTeam.json"
      }
    },
    {
      "@id": "ActorDefinition-OperationsTeam",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/OperationsTeam",
      "dcterms:title": "Operations Team",
      "dcterms:description": "The operations team of the Trust Network Gateway's service provider, which registers a Participant's key material and verifies its pull requests (onboarding steps [30]-[50]).",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/OperationsTeam"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-OperationsTeam.json"
      }
    },
    {
      "@id": "ActorDefinition-Receiver",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/Receiver",
      "dcterms:title": "Receiver",
      "dcterms:description": "A Reciever is a system authorized by a Trust Network Participant to receive from a Holder a Veritifable, verify and utilize the content within.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/Receiver"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-Receiver.json"
      }
    },
    {
      "@id": "ActorDefinition-TechnicalRepresentative",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/TechnicalRepresentative",
      "dcterms:title": "Technical Representative",
      "dcterms:description": "The Technical Representative of a GDHCN Participant, named in the Letter of Application (Framework IX). Connects the Participant's systems to the Trust Network Gateway and runs the onboarding tests.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/TechnicalRepresentative"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-TechnicalRepresentative.json"
      }
    },
    {
      "@id": "ActorDefinition-TrustNetworkAnchor",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/TrustNetworkAnchor",
      "dcterms:title": "Trust Network Anchor",
      "dcterms:description": "Trust Anchor which receives and distributes PKI-material within a Trust Network",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/TrustNetworkAnchor"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-TrustNetworkAnchor.json"
      }
    },
    {
      "@id": "ActorDefinition-TrustNetworkGateway",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/TrustNetworkGateway",
      "dcterms:title": "Trust Network Gateway",
      "dcterms:description": "The Trust Network Gateway through which the GDHCN is operationalized (Framework V.1). It whitelists a Participant's certificates and accepts its connections.",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/TrustNetworkGateway"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-TrustNetworkGateway.json"
      }
    },
    {
      "@id": "ActorDefinition-TrustNetworkParticipant",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/TrustNetworkParticipant",
      "dcterms:title": "Trust Network Participant",
      "dcterms:description": "Trust Network Participant which publishes and or receives PKI-material within a Trust Network",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/TrustNetworkParticipant"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-TrustNetworkParticipant.json"
      }
    },
    {
      "@id": "ActorDefinition-WHOCountryRepresentative",
      "@type": "fhir:ActorDefinition",
      "dcterms:identifier": "ActorDefinition/WHOCountryRepresentative",
      "dcterms:title": "WHO Country Representative",
      "dcterms:description": "The WHO Country Representative, or the WHO Country Office, who may meet a GDHCN Participant's representative in person and send the Letter of Application by diplomatic pouch to WHO Headquarters (Framework IX).",
      "dcterms:type": "Requirements: Actor Definitions",
      "schema:sameAs": {
        "@id": "http://smart.who.int/trust/ActorDefinition/WHOCountryRepresentative"
      },
      "schema:contentUrl": {
        "@id": "../ActorDefinition-WHOCountryRepresentative.json"
      }
    },
    {
