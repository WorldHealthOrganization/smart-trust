{
  "name": "@litlfred/bootstrap-tools",
  "version": "0.1.0",
  "private": true,
  "description": "The Zod source of bootstrap's schemas, their generators, and the checks bootstrap's content must pass. Depends on zod; liquidjs for the README templates; Playwright and bpmn-js to draw a Process.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": "https://github.com/litlfred/bootstrap-tools",
  "scripts": {
    "vocabulary": "bun run scripts/gen-vocabulary.ts",
    "vocabulary:check": "bun run scripts/gen-vocabulary.ts --check",
    "graph": "bun run scripts/export-graph.ts",
    "subgraphs": "bun run scripts/subgraph-jsonld.ts",
    "subgraphs:check": "bun run scripts/subgraph-jsonld.ts --check --root ../bootstrap --root .",
    "publish": "bun run scripts/publish-files.ts",
    "render": "bun run scripts/render-bpmn.ts",
    "render:check": "bun run scripts/render-bpmn.ts --check",
    "readmes": "bun run scripts/subgraph-readmes.ts",
    "readmes:check": "bun run scripts/subgraph-readmes.ts --check",
    "readme-sections": "bun run scripts/readme-sections.ts",
    "readme-sections:check": "bun run scripts/readme-sections.ts --check",
    "schemas": "bun run scripts/gen-bootstrap-schemas.ts",
    "schemas:check": "bun run scripts/gen-bootstrap-schemas.ts --check",
    "semver": "bun run scripts/schema-semver.ts",
    "validate": "bun run scripts/validate-bootstrap.ts",
    "iri:sync": "bun run scripts/iri-sync.ts",
    "iri:sync:check": "bun run scripts/iri-sync.ts --check",
    "check:closure": "bun run scripts/check-closure.ts",
    "check:node-iris": "bun run scripts/check-node-iris.ts",
    "check:concepts": "bun run scripts/check-bootstrap-concepts.ts",
    "check:standalone": "bun run scripts/rehearse-standalone.ts",
    "test": "bun test .",
    "typecheck": "tsc --noEmit -p .",
    "book": "bun run scripts/readme-book.ts",
    "book:check": "bun run scripts/readme-book.ts --check",
    "site": "bun run scripts/site.ts",
    "init": "bun run scripts/init.ts",
    "pages:status": "bun run scripts/pages-status.ts"
  },
  "dependencies": {
    "@fontsource/arimo": "^5.3.0",
    "@playwright/test": "1.63.0",
    "bpmn-js": "18.31.0",
    "liquidjs": "^10.29.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "ajv": "^6.15.0",
    "bun-types": "latest",
    "playwright": "1.63.0",
    "typescript": "6.0.3"
  }
}
