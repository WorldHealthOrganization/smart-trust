      "candidates": [
        {
          "text": "Читать из результата: пустая группа запросов (или нет карточки) ничего не спрашивает у медицинского работника.",
          "source": {
            "kind": "open-mt",
            "id": "Helsinki-NLP/opus-mt-en-ru",
            "at": "2026-11-15T07:08:18.232Z"
          }
        }
      ]
    },
    {
