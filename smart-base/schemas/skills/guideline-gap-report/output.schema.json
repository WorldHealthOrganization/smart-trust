{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Guideline Gap Report Output",
  "description": "One row per gap in the L1 -> L2 -> L3 chain and its reviews, with counts per kind and stage.",
  "type": "object",
  "required": [
    "gaps",
    "summary"
  ],
  "properties": {
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/gap"
      }
    },
    "summary": {
      "type": "object",
      "description": "Count of gaps per kind, and per stage.",
      "properties": {
        "byKind": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "byStage": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "notRun": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Stages not run yet: reported as not run, never as having no gaps."
        }
      }
    },
    "stagingLinks": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "description": "The staged report page, and its anchor per role."
    }
  },
  "definitions": {
    "gap": {
      "type": "object",
      "required": [
        "kind",
        "asset",
        "stage",
        "role",
        "reason"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "l1-uncovered",
            "figure-not-computable",
            "l1-no-l2",
            "l2-no-l1",
            "l2-no-l3",
            "l3-no-l2",
            "no-test-client",
            "review-not-requested",
            "review-pending",
            "review-sent-back",
            "rejected-upstream"
          ]
        },
        "asset": {
          "type": "string",
          "description": "The asset's KG id or path."
        },
        "stage": {
          "type": "string",
          "description": "The stage that closes the gap."
        },
        "role": {
          "type": "string",
          "description": "The reviewing role id (clinical-sme, programme-manager, business-analyst, fhir-modeller, terminologist, l1-extraction-reviewer)."
        },
        "reason": {
          "type": "string",
          "description": "One sentence: what is missing."
        },
        "reviewItem": {
          "type": "string",
          "format": "uri",
          "description": "The asset's review item, in the form its role reads, when one exists."
        }
      }
    }
  }
}
